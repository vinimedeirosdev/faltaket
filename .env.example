# ──────────────────────────────────────────────────────────────
# Faltaket (web): copie para .env.local e preencha.
#   cp .env.example .env.local
# Onde achar: Console do Firebase → ⚙ Configurações do projeto →
# Geral → "Seus apps" → app Web → "Configuração do SDK".
# Esses valores NÃO são segredos (vão para o navegador). Quem protege
# os dados são as Security Rules do repositório faltaket-server.
# ──────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Domínio do e-mail "sintético" usado no login por nome de usuário
# (usuario → usuario@faltaket.app). PRECISA ser igual ao AUTH_EMAIL_DOMAIN
# usado na migração (faltaket-server/.env). Não precisa existir de verdade.
VITE_AUTH_EMAIL_DOMAIN=faltaket.app

# true = conecta nos emuladores locais (Auth :9099, Firestore :8080)
# rodando a partir do faltaket-server (npm run emulators).
VITE_USE_EMULATORS=false
