{
  "name": "faltaket",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "PWA para controlar faltas da faculdade",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
